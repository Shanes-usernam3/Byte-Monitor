{
  "name": "byte-monitor",
  "version": "0.1.9",
  "description": "Byte Monitor \u2014 desktop hardware health & space monitor by HardPoint Networks",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "author": {
    "name": "HardPoint Networks",
    "email": "138325144+Shanes-usernam3@users.noreply.github.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "productName": "Byte Monitor",
  "build": {
    "appId": "ca.hardpointnetworks.bytemonitor",
    "productName": "Byte Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "extraResources": [
        {
          "from": "licenses",
          "to": "licenses",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "LICENSE",
          "to": "licenses/LICENSE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "licenses/THIRD-PARTY-NOTICES.md"
        },
        {
          "from": "build/smartctl",
          "to": "smartctl",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/sensors",
          "to": "sensors",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Byte Monitor"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "System",
      "maintainer": "HardPoint Networks <138325144+Shanes-usernam3@users.noreply.github.com>",
      "synopsis": "Hardware health monitor",
      "extraResources": [
        {
          "from": "licenses",
          "to": "licenses",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "LICENSE",
          "to": "licenses/LICENSE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "licenses/THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "deb": {
      "depends": [
        "smartmontools",
        "lm-sensors"
      ]
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "homepage": "https://github.com/shanes-usernam3/Byte-Monitor"
}
